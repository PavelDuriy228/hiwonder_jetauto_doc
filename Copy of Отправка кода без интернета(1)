альной скорости\nSTEP_LIN \u003d 0.05    # На сколько м/с увеличивается скорость за одно нажатие (вперед/вбок)\nSTEP_ANG \u003d 0.2     # На сколько рад/с увеличивается вращение\nMAX_LIN \u003d 0.5      # Максимальная скорость м/с (защита)\nMAX_ANG \u003d 1.5      # Максимальная скорость вращения\n\ndef get_key():\n    tty.setraw(sys.stdin.fileno())\n    select.select([sys.stdin], [], [], 0)\n    key \u003d sys.stdin.read(1)\n    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)\n    return key\n\ndef constrain(val, min_val, max_val):\n    return min(max(val, min_val), max_val)\n\nif __name__\u003d\u003d\"__main__\":\n    settings \u003d termios.tcgetattr(sys.stdin)\n    rospy.init_node(\u0027smart_teleop\u0027)\n    pub \u003d rospy.Publisher(\u0027/cmd_vel\u0027, Twist, queue_size\u003d1)\n    \n    twist \u003d Twist()\n    \n    # Текущие скорости\n    lin_x \u003d 0.0\n    lin_y \u003d 0.0\n    ang_z \u003d 0.0\n\n    print(msg)\n    try:\n        while not rospy.is_shutdown():\n            key \u003d get_key()\n            \n            # Логика изменения скорости\n            if key \u003d\u003d \u0027w\u0027:\n                lin_x \u003d constrain(lin_x + STEP_LIN, -MAX_LIN, MAX_LIN)\n            elif key \u003d\u003d \u0027s\u0027:\n                lin_x \u003d constrain(lin_x - STEP_LIN, -MAX_LIN, MAX_LIN)\n            elif key \u003d\u003d \u0027a\u0027:\n                lin_y \u003d constrain(lin_y + STEP_LIN, -MAX_LIN, MAX_LIN)\n            elif key \u003d\u003d \u0027d\u0027:\n                lin_y \u003d constrain(lin_y - STEP_LIN, -MAX_LIN, MAX_LIN)\n            elif key \u003d\u003d \u0027q\u0027:\n                ang_z \u003d constrain(ang_z + STEP_ANG, -MAX_ANG, MAX_ANG)\n            elif key \u003d\u003d \u0027e\u0027:\n                ang_z \u003d constrain(ang_z - STEP_ANG, -MAX_ANG, MAX_ANG)\n            elif key \u003d\u003d \u0027 \u0027:\n                lin_x \u003d 0.0\n                lin_y \u003d 0.0\n                ang_z \u003d 0.0\n            elif key \u003d\u003d \u0027\\x03\u0027: # Ctrl+C\n                break\n                \n            # Запись в сообщение\n            twist.linear.x \u003d lin_x\n            twist.linear.y \u003d lin_y\n            twist.angular.z \u003d ang_z\n            pub.publish(twist)\n            \n            # Красивый вывод текущей скорости (заменяет строку, не спамит)\n            sys.stdout.write(\"\\rТекущая скорость -\u003e Вперед: %5.2f | Вбок: %5.2f | Вращение: %5.2f  \" % (lin_x, lin_y, ang_z))\n            sys.stdout.flush()\n            \n    finally:\n        # Гарантированная остановка при выходе\n        twist.linear.x \u003d 0.0\n        twist.linear.y \u003d 0.0\n        twist.angular.z \u003d 0.0\n        pub.publish(twist)\n        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)\n        print(\"\\nРобот остановлен. Выход.\")\n```\n\n### Как запустить (напоминалка):\n1. Не забудь, что в другом окне (или по SSH) уже должен работать `roslaunch jetauto_bringup bringup.launch`.\n2. В новом окне:\n```bash\npython ~/Desktop/smart_teleop.py\n```\n\nПопробуй поиграться! Попробуй нажать `W` два раза, а потом `A` один раз — робот поедет **по диагонали** (так работают меканум-колеса).\n\nКак настроишь SSH, скажи. Можем написать скрипт, который заставит его проехать квадрат абсолютно автономно (без твоего участия) или запустить LIDAR, чтобы он нарисовал карту комнаты на твоем экране.",
